@section Scripts {
    <script>
        let rowIndex = @(Model.SalesInventoryDetails?.Count() ?? 0)
        let additionalRowIndex = @(Model.SalesAdditionalLedgers?.Count() ?? 0)

        // Track the row being edited
        let editingRowIndex = null;

        // Edit button click: populate form with row data
        $(document).on('click', '.edit-inventory-row', function () {
               $('#collapseThree').collapse('show');
 
         $('#salesInventoryTableBody tr').each(function(i) {
            $(this).attr('data-row-index', i);
            $(this).find('.remove-inventory-row, .edit-inventory-row').data('row-index', i);
        });
        $('#salesInventoryData .inventory-data').each(function(i) {
            $(this).attr('data-row-index', i);
        });

            editingRowIndex = $(this).data('row-index');
             let $row = $('#salesInventoryTableBody tr[data-row-index="' + editingRowIndex + '"]');
             let $hidden = $('#salesInventoryData .inventory-data[data-row-index="' + editingRowIndex + '"]');

            // Populate form fields
            let $template = $('#salesInventoryTemplate .ledger-row');
            $template.find('.stockItemName').val($hidden.find('.stockItemId').val()).trigger('change');
            $template.find('input[name="salesInputQuantity"]').val($hidden.find('.quantity').val());
            $template.find('input[name="salesInputRate"]').val($hidden.find('.rate').val());
            $template.find('input[name="salesInputDiscount"]').val($hidden.find('.discount').val());
            $template.find('input[name="salesInputAmount"]').val($hidden.find('.amount').val());
            $template.find('#salesInputGodownId').val($hidden.find('.godownId').val()).trigger("change");
            $template.find('#salesInputAccountingLedgerId').val($hidden.find('.accountingLedgerId').val()).trigger("change");
            $template.find('select[name="salesInputCostCentreId"]').val($hidden.find('.costCentreId').val()) .trigger("change");

            // Batch and expiry
            let hasBatch = $hidden.find('.hasBatch').val() === "true" || $hidden.find('.hasBatch').val() === "True";
            $template.find('.has-batch-checkbox').prop('checked', hasBatch).trigger('change');
            if (hasBatch) {
                $template.find('#BatchNameInput').val($hidden.find('.batchName').val());
                let isExpiry = $hidden.find('.isExpiryDate').val() === "true" || $hidden.find('.isExpiryDate').val() === "True";
                $template.find('.expiry-date-checkbox').prop('checked', isExpiry).trigger('change');
                if (isExpiry) {
                    $template.find('#ExpiryDateInput').val($hidden.find('.batchExpiry').val());
                }
            }

            // Change Add to Update + Cancel
            $('#addInventoryRow').hide();

            if ($('#updateInventoryRow').length === 0) {
                $('#addInventoryRow').after(`
                    <button type="button" id="updateInventoryRow" class="btn btn-subtle-success mb-1 mt-2 float-end" style="width:auto;">Update</button>
                    <button type="button" id="cancelInventoryEdit" class="btn btn-subtle-danger mb-1 mt-2 float-end me-2" style="width:auto;">Cancel</button>
                `);
            } else {
                $('#updateInventoryRow').show();
                $('#cancelInventoryEdit').show();
            }
        });

        // Cancel button: reset form and switch buttons back
        $(document).on('click', '#cancelInventoryEdit', function () {
            let $template = $('#salesInventoryTemplate .ledger-row');

            // Clear form fields
            $template.find('input, select').val('');
            $template.find('.has-batch-checkbox, .expiry-date-checkbox').prop('checked', false);

            // Switch buttons
            $('#updateInventoryRow').hide();
            $('#cancelInventoryEdit').hide();
            $('#addInventoryRow').show();

            // Reset editing row index
            editingRowIndex = null;
        });

        // Update button click: update row and hidden fields
        $(document).on('click', '#updateInventoryRow', function () {
            if (editingRowIndex === null) return;
            let $template = $('#salesInventoryTemplate .ledger-row');
            let stockItemId = $template.find('.stockItemName').val();
            let stockItemText = $template.find('.stockItemName option:selected').text();
            let vat = $template.find('.stockItemVat').val();
            let qty = $template.find('input[name="salesInputQuantity"]').val();
            let rate = $template.find('input[name="salesInputRate"]').val();
            let discount = $template.find('input[name="salesInputDiscount"]').val();
            let amount = $template.find('input[name="salesInputAmount"]').val();
            let godownId = $template.find('#salesInputGodownId').val();
            let ledgerId = $template.find('#salesInputAccountingLedgerId').val();
            let costCentreId = $template.find('select[name="salesInputCostCentreId"]').val();
            let hasBatch = $template.find('.has-batch-checkbox').is(':checked');
            let batchName = $template.find('#BatchNameInput').val();
            let isExpiry = $template.find('.expiry-date-checkbox').is(':checked');
            let batchExpiry = $template.find('#ExpiryDateInput').val();

            // Update table row
            let $row = $('#salesInventoryTableBody tr[data-row-index="' + editingRowIndex + '"]');
            $row.find('td').eq(0).text(stockItemText);
            $row.find('td').eq(1).text($template.find('select[name="salesInputCostCentreId"] option:selected').text());
            $row.find('td').eq(2).text(qty);
            $row.find('td').eq(3).text(rate);
            $row.find('td').eq(4).text(discount);
            $row.find('td').eq(5).text(vat);
            $row.find('td').eq(6).text(amount);

            // Update hidden fields
            let $hidden = $('#salesInventoryData .inventory-data[data-row-index="' + editingRowIndex + '"]');
            $hidden.find('.stockItemId').val(stockItemId);
            $hidden.find('.costCentreId').val(costCentreId);
            $hidden.find('.batchStockItemId').val(stockItemId);
            $hidden.find('.quantity').val(qty);
            $hidden.find('.rate').val(rate);
            $hidden.find('.discount').val(discount);
            $hidden.find('.amount').val(amount);
            $hidden.find('.godownId').val(godownId);
            $hidden.find('.accountingLedgerId').val(ledgerId);
            $hidden.find('.hasBatch').val(hasBatch);
            $hidden.find('.batchName').val(batchName);
            $hidden.find('.isExpiryDate').val(isExpiry);
            $hidden.find('.batchExpiry').val(batchExpiry);
            $hidden.find('.taxRate').val(vat);
            // Reset form and button
            $template.find('input, select').val('');
            $template.find('.expiry-date-checkbox').prop('checked', false).trigger('change');
            $template.find('.has-batch-checkbox').prop('checked', false).trigger('change');
            $template.find('.stockItemVat').val(vat);
            // Then switch buttons back
            $('#updateInventoryRow').hide();
            $('#cancelInventoryEdit').hide();
            $('#addInventoryRow').show();

            editingRowIndex = null;

            calculateVatForRows();
        });

        // adding additional ledger rows
            $(document).on("click", "#addAdditionalLedger", function () {
            let template = $("#ledgerRowTemplate").html();
            let costCentreId = $('#salesInventoryTemplate select[name="salesInputCostCentreId"]').val();

            let newRow = template.replace(/__index__/g, additionalRowIndex);
            let $newRow = $(newRow);

            // Auto-set CostCentreId
            $newRow.find('.costCenterDrp').val(costCentreId).trigger('change');
            $newRow.find('.costCentreId').val(costCentreId);

                   $("#salesAdditionalLedgerContainer .additional-ledgers-container").append($newRow);

        $newRow.find('.additionalLedgerDrp, .costCenterDrp').each(function () {
            let $this = $(this);

            // destroy if already initialized (safe way)
            if ($this.hasClass("select2-hidden-accessible")) {
                $this.select2('destroy');
            }

            $this.select2({
                placeholder: "-- Select --",
                width: '100%',
                dropdownParent: $newRow   // 🔥 best fix
            });
        });


            additionalRowIndex++;
        });

        // Remove row
        $(document).on('click', '.remove-row', function () {
            $(this).closest('.ledger-row').remove();
            calculateVatForRows();
        });

        // when percentage changes, update amount
        $(document).on('input', '.ledger-vat-tax', function () {
            calculateVatForRows();
        });

        // when amount changes, update percentage
        $(document).on('input', '.salesAdditionalAmount', function () {
            var amount = parseFloat($(this).val()) || 0;
            var baseAmount = getBaseAmount();

            if (baseAmount > 0) {
                var per = (amount / baseAmount) * 100;
                $(this).closest(".ledger-row").find(".salesAdditionalPer").val(per.toFixed(2));
            }

            calculateVatForRows();
        });

        // when additional ledger changes
        $(document).on('change', '.additionalLedgerDrp', function(){
            var _that = $(this);
            var ledgerId = $(_that).val();

            $.ajax({
                url: '/master/get-ledger-master-details', // Adjust to your API endpoint
                type: 'GET',
                data: { ledgerId: ledgerId },
                success: function (result) {
                    var data = result.data;
                    $(_that).closest(".ledger-row").find("input[name*='LedgerTaxRate']").val(data.ledgerTaxRate || 0);
                }
            });
        });

        // has inventory checkbox
        $(document).on('change', '.has-inventory-checkbox', function () {
            if ($(this).is(':checked')) {
                $('#HasInventory').val(true);
                $('.inventory-row').removeClass('has-no-inventory').addClass('has-inventory');
            } else {
                $('#HasInventory').val(false);
                $('.inventory-row').removeClass('has-inventory').addClass('has-no-inventory');
            }
        });

        // When opening the modal, store the triggering checkbox
        $(document).on('change', '.has-batch-checkbox', function () {
            if ($(this).is(':checked')) {
                $('.batch-data').show();
                $('.expiry-date-active').show();
                $('#BatchNameInput').prop('required', true);

            } else {
                $('.batch-data').hide();
                $('.expiry-date-active').hide();
                $('.expiry-date-data').hide();
                $('#BatchNameInput').prop('required', false);
                $("#IsExpiryDate").prop("checked", false);
                $('#BatchNameInput').val('');
                $('#ExpiryDateInput').val('');
            }
        });

        $(document).on('change', '#IsExpiryDate', function () {
            if ($(this).is(':checked')) {
                $('.expiry-date-data').show();

            } else {
                $('.expiry-date-data').hide();
                $('#ExpiryDateInput').val('');
            }
        });

            $(document).on('input', '#salesInputDiscount', function () {
            let discount = parseFloat($(this).val());
            if (isNaN(discount)) return;
            if (discount < 0) {
                $(this).val(0);
            } else if (discount > 100) {
                $(this).val(100);
            }
        });

        // Bind auto calculation on input change
        $(document).on('input', '#salesInputQuantity, #salesInputRate, #salesInputDiscount', function () {
            let $row = $(this).closest('.ledger-row');
        // $('.additionalLedgerDrp, .costCenterDrp').select2({
        //        placeholder: "-- Select --",
        //        width: '100%'
        //    });

            calculateAmount($row);
        });

        // Show modal when LedgerId changes
        // $(document).on('change', '#LedgerId', function () {
        //     var ledgerId = $(this).val();
        //     $('#LedgerIdInput').val(ledgerId);

