                  $(document).on('input', '.ledger-vat-tax', function () {
                  let val = this.value;
                 val = val.replace(/[^0-9.]/g, '');
                 let parts = val.split('.');
             if (parts.length > 2) {
                 val = parts[0] + '.' + parts[1];
             }
            if (val.includes('.')) {
                let split = val.split('.');
                split[1] = split[1].slice(0, 2);
                val = split[0] + '.' + split[1];
            }
            if (val.length > 6) {
                val = val.slice(0, 6);
            }
            if (parseFloat(val) > 100) {
                val = "100.00";
            }
            this.value = val;
        });

        $(document).on('blur', '.ledger-vat-tax', function () {
