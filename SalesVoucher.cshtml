@using Aignite.Models.DynamicModels
@using Aignite.ViewModel.UiViewModel
@model SalesViewModel
@{
    Layout = "/Views/Shared/_CommonLayout.cshtml";
    var title = Model.Id > 0 ? "Edit Sales Voucher" : "Create Sales Voucher";
    var stockItemList = ViewBag.StockVatList as List<StockMaster>;
    var hasAdditionalLedger = Model.SalesAdditionalLedgers != null && Model.SalesAdditionalLedgers?.Any() == true;
}
<style>
    button.btn.btn-outline-danger.remove-row {
        --phoenix-btn-padding-x: 0.5rem;
    }

    .select2-container {
        width: 100% !important;
    }
    .has-no-inventory {
        display: none;
    }

    .has-inventory {
        display: block;
    }

    .form-check.form-switch {
        cursor: pointer;
    }

    .input-error {
        border: 1px solid red !important;
    }
</style>
<nav class="mb-3" aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("SalesVoucherList", "Voucher")">Sales Voucher List</a></li>
        <li class="breadcrumb-item active">@title</li>
    </ol>
</nav>


<div class="mb-9">
    @using (Html.BeginForm("CreateSalesVoucher", "Voucher", FormMethod.Post, new { @class = "row g-3", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        @Html.HiddenFor(m => m.Vouchertype)
        @Html.HiddenFor(m => m.DeliveryNoteNo)
        @Html.HiddenFor(m => m.DispatchDocNo)
        @Html.HiddenFor(m => m.DispatchedThrough)
        @Html.HiddenFor(m => m.Destination)
        @Html.HiddenFor(m => m.CarrierName)
        @Html.HiddenFor(m => m.Lrnumber)
        @Html.HiddenFor(m => m.OrderNo)
        @Html.HiddenFor(m => m.SalesDate)
        @Html.HiddenFor(m => m.ModeOfPayment)
        @Html.HiddenFor(m => m.OtherReferences)
        @Html.HiddenFor(m => m.Termsofdelivery)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <h2 class="mb-0">@title</h2>
            <div class="d-flex gap-4 align-items-center">
                <div class="d-flex flex-wrap align-items-end gap-4">
                    <div class="form-check form-switch min-h-auto flex-1 mb-0 mt-4 d-flex align-items-end justify-content-center">
                        @Html.CheckBoxFor(m => m.HasInventory, new { @class = "form-check-input has-inventory-checkbox me-2" })
                        @* <input type="checkbox" name="HasInventory" id="HasInventory" value="@Model.HasInventory" class="form-check-input has-inventory-checkbox me-2" /> *@
                        <label class="form-label" for="HasInventory">Has Inventory</label>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-end gap-4">
                    <div>
                        <label class="form-label mb-0 me-2 w-100" for="Vouchercurrency">
                            Currency
                        </label>

                        @Html.DropDownListFor(m => m.Vouchercurrency, ViewBag.CurrencyList as IEnumerable<SelectListItem>, "-- Select --", new { @class = "form-select d-inline-block w-100", id = "currencyDropdown" })
                        @Html.ValidationMessageFor(m => m.Vouchercurrency, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <div class="border-top border-translucent">
        <h5 class="mt-2">Sales Information</h5>
    </div>

    <div class="col-md-3">
        <label class="form-label" for="VoucherDate">Voucher Date</label>
            @Html.TextBoxFor(m => m.VoucherDate, new { @class = "form-control datepicker", id = "voucherDate", type = "text", placeholder = "dd/MM/yyyy", required = "true", data_options = "{\"disableMobile\":true,\"dateFormat\":\"d/m/Y\"}" })
            @Html.ValidationMessageFor(m => m.VoucherDate, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-3">
        <label class="form-label" for="VoucherNumber">Voucher Number</label>
        @Html.TextBoxFor(m => m.VoucherNumber, new { @class = "form-control", type = "text", placeholder = "Voucher number", required = "true" })
        @Html.ValidationMessageFor(m => m.VoucherNumber, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-3">
        <label class="form-label" for="ReferenceNumber">Reference Number</label>
        @Html.TextBoxFor(m => m.ReferenceNumber, new { @class = "form-control", type = "text", placeholder = "Reference Number" })
        @Html.ValidationMessageFor(m => m.ReferenceNumber, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-3">
        <label class="form-label" for="ReferenceDate">Reference Date</label>
        @Html.TextBoxFor(m => m.ReferenceDate, new { @class = "form-control datepicker", type = "text", placeholder = "dd/MM/yyyy", data_options = "{\"disableMobile\":true,\"dateFormat\":\"d/m/Y\"}" })
        @Html.ValidationMessageFor(m => m.ReferenceDate, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-3">
        <label class="form-label" for="LedgerId">Ledger</label>

        @Html.DropDownListFor(
                m => m.LedgerId,
                ViewBag.LedgerList as IEnumerable<SelectListItem>,
                "-- Select --",
                new { @class = "form-select w-100", required = "true" }
                )

        @Html.ValidationMessageFor(m => m.LedgerId, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-3">
        <label class="form-label" for="CostCentreId">Cost Centre</label>
        @Html.DropDownListFor(
                m => m.CostCentreId,
                ViewBag.CostCentreList as IEnumerable<SelectListItem> ?? new List<SelectListItem>(),
                                "-- Select --",
                new { @class = "form-select w-100" }
                )
        @Html.ValidationMessageFor(m => m.CostCentreId, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-3 d-flex align-items-end gap-2">
        <div class="w-100">
            <label class="form-label" for="ExchangeRate">Exchange Rate</label>
            @Html.TextBoxFor(m => m.ExchangeRate, new { @class = "form-control decimal-only", id = "ExchangeRate", type = "text", inputmode = "decimal", min = "0", step = "0.0001", required = "true", @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.ExchangeRate, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="BillReferenceNumber">Bill Reference</label>
        <div class="input-group">
            <span class="input-group-text">@ViewBag.BillReferencePrefixes</span>
            @Html.TextBoxFor(m => m.BillReferenceNumber, new
                        {
                        @class = "form-control",
                        type = "text",
                        placeholder = "Enter reference number",
                        required = "true"
                        })
        </div>
        @Html.ValidationMessageFor(m => m.BillReferenceNumber, "", new { @class = "text-danger" })
    </div>

        // end add in popup
    <div class="accordion" id="accordionExample">
        <div class="accordion-item border-top">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                    Buyer Information
                </button>
            </h2>
            <div class="accordion-collapse collapse show" id="collapseOne" aria-labelledby="headingOne" data-bs-parent="#accordionExample" style="">
                <div class="accordion-body pt-0 row">
                    <div class="col-md-3">
                        <label class="form-label" for="BuyerName">Buyer Name</label>
                        @Html.TextBoxFor(m => m.BuyerName, new { @class = "form-control", type = "text", placeholder = "Buyer Name", required = "true" })
                        @Html.ValidationMessageFor(m => m.BuyerName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="BuyerAddress1">Buyer Address 1</label>
                        @Html.TextBoxFor(m => m.BuyerAddress1, new { @class = "form-control", type = "text", placeholder = "Buyer Address 1" })
                        @Html.ValidationMessageFor(m => m.BuyerAddress1, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="BuyerAddress2">Buyer Address 2</label>
                        @Html.TextBoxFor(m => m.BuyerAddress2, new { @class = "form-control", type = "text", placeholder = "Buyer Address 2" })
                        @Html.ValidationMessageFor(m => m.BuyerAddress2, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="BuyerEmirate">Buyer Emirate</label>
                        @Html.TextBoxFor(m => m.BuyerEmirate, new { @class = "form-control", type = "text", placeholder = "Buyer Emirate" })
                        @Html.ValidationMessageFor(m => m.BuyerEmirate, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="BuyerCountry">Buyer Country</label>
                        @Html.TextBoxFor(m => m.BuyerCountry, new { @class = "form-control", type = "text", placeholder = "Buyer Country" })
                        @Html.ValidationMessageFor(m => m.BuyerCountry, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="BuyerPobox">Buyer PO Box</label>
                        @Html.TextBoxFor(m => m.BuyerPobox, new { @class = "form-control", type = "text", placeholder = "Buyer PO Box" })
                        @Html.ValidationMessageFor(m => m.BuyerPobox, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="BuyerTrn">Buyer Trn</label>
                        @Html.TextBoxFor(m => m.BuyerTrn, new { @class = "form-control", type = "text", placeholder = "Buyer Trn" })
                        @Html.ValidationMessageFor(m => m.BuyerTrn, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-item border-top">
            <h2 class="accordion-header" id="headingTwo">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                    Consignee Information
                </button>
            </h2>
            <div class="accordion-collapse collapse" id="collapseTwo" aria-labelledby="headingTwo" data-bs-parent="#accordionExample" style="">
                <div class="accordion-body pt-0 row">
                    <div class="col-md-3">
                        <label class="form-label" for="ConsigneeName">Consignee Name</label>
                        @Html.TextBoxFor(m => m.Consigneename, new { @class = "form-control", type = "text", placeholder = "Consignee Name" })
                        @Html.ValidationMessageFor(m => m.Consigneename, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ConsigneeAddress1">Consignee Address 1</label>
                        @Html.TextBoxFor(m => m.ConsigneeAddress1, new { @class = "form-control", type = "text", placeholder = "Consignee Address 1" })
                        @Html.ValidationMessageFor(m => m.ConsigneeAddress1, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ConsigneeAddress2">Consignee Address 2</label>
                        @Html.TextBoxFor(m => m.ConsigneeAddress2, new { @class = "form-control", type = "text", placeholder = "Consignee Address 2" })
                        @Html.ValidationMessageFor(m => m.ConsigneeAddress2, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ConsigneeEmirate">Consignee Emirate</label>
                        @Html.TextBoxFor(m => m.ConsigneeEmirate, new { @class = "form-control", type = "text", placeholder = "Consignee Emirate" })
                        @Html.ValidationMessageFor(m => m.ConsigneeEmirate, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ConsigneeCountry">Consignee Country</label>
                        @Html.TextBoxFor(m => m.ConsigneeCountry, new { @class = "form-control", type = "text", placeholder = "Consignee Country" })
                        @Html.ValidationMessageFor(m => m.ConsigneeCountry, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ConsigneePobox">Consignee PO Box</label>
                        @Html.TextBoxFor(m => m.ConsigneePobox, new { @class = "form-control", type = "text", placeholder = "Consignee PO Box" })
                        @Html.ValidationMessageFor(m => m.ConsigneePobox, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-item border-top inventory-row @(Model.HasInventory ? "has-inventory" : "has-no-inventory")">
            <h2 class="accordion-header" id="headingThree">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                    Inventory Addon's
                </button>
            </h2>
            <div class="accordion-collapse collapse" id="collapseThree" aria-labelledby="headingThree" data-bs-parent="#accordionExample" style="">
                <div class="accordion-body pt-0 row">
                    <div class="row salesInventory px-0" id="salesInventoryContainer">
                        <div id="salesInventoryTemplate">
                            <div class="row ledger-row mb-3 p-2 border rounded bg-light ms-2" data-index="__index__">
                                <input type="hidden" name="salesInventoryInputId" id="salesInventoryInputId" class="sales-inventory-id " value="0" />
                                <input type="hidden" name="salesInputId" id="salesInputId" class="sales-id" value="0" />
                                <div class="col-md-2">
                                    <label class="form-label w-100">Stock Item</label>
                                    <select name="salesInputStockItemId" id="salesInputStockItemId" class="stockItemName form-select w-100" style="width:100%;">
                                            @if (stockItemList != null && stockItemList.Any())
                                            {
                                                foreach (var item in stockItemList)
                                                {
                                                    <option value="@item.StockItemId" data-taxrate="@item.TaxRate">
                                                        @item.StockItemName
                                                    </option>
                                                }
                                            }
                                            else
                                            {
                                                <option value="">-- No Stock Items --</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">VAT</label>
                                        <input type="text" inputmode="decimal"  name="stockItemVat"
                                               class="form-control integer-only stockItemVat" min="0" step="1" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Quantity</label>
                                        <input type="text" inputmode="decimal" name="salesInputQuantity" id="salesInputQuantity" class="form-control decimal-only" min="0" step="1" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Rate</label>
                                        <input type="text" inputmode="decimal" name="salesInputRate" id="salesInputRate" class="form-control decimal-only" min="0" step="1" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Discount (%)</label>
                                        <input type="text" inputmode="decimal" name="salesInputDiscount" id="salesInputDiscount" class="form-control decimal-only" min="0" max="100" step="0.01" value="0" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Amount</label>
                                        <input type="text" inputmode="decimal" name="salesInputAmount" id="salesInputAmount" class="form-control" readonly  />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label w-100">Accounting Ledger</label>
                                        <select name="salesInputAccountingLedgerId" id="salesInputAccountingLedgerId" class="form-select w-100" style="width:100%;">
                                                @if (ViewBag.AccountingLegderList != null && ((List<SelectListItem>)ViewBag.AccountingLegderList).Any())
                                                {
                                                    foreach (var item in (List<SelectListItem>)ViewBag.AccountingLegderList)
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="">-- No Ledgers Available --</option>
                                                }
                                            </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label w-100">Cost Centre</label>
                                        <select name="salesInputCostCentreId"
                                                class="form-select w-100" style="width:100%;">
                                            <option value="">-- Select --</option>
                                            @if (ViewBag.CostCentreList != null)
                                            {
                                                foreach (var item in (List<SelectListItem>)ViewBag.CostCentreList)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-check form-switch min-h-auto flex-1 mb-0 mt-4 d-flex align-items-end justify-content-center">
                                            <input type="checkbox" name="salesInputHasBatch" id="salesInputHasBatch" value="false" class="form-check-input has-batch-checkbox me-2" />
                                            <label class="form-label" for="salesInputHasBatch">Has Batch</label>
                                        </div>
                                    </div>
                                    <div class="col-md-2 batch-data" style="display:none;">
                                        <label class="form-label">Batch Name</label>
                                        <input type="text" id="BatchNameInput" class="form-control" />
                                    </div>
                                    <div class="col-md-2 expiry-date-active" style="display:none;">
                                        <div class="form-check form-switch min-h-auto flex-1 mb-0 mt-4 d-flex align-items-end justify-content-center">
                                            <input type="checkbox" name="IsExpiryDate" id="IsExpiryDate" value="false" class="form-check-input expiry-date-checkbox me-2" />
                                            <label class="form-label" for="IsExpiryDate">Has Expiry</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3 expiry-date-data" style="display:none;">
                                        <label class="form-label">Expiry Date</label>
                                        <input type="text" id="ExpiryDateInput" class="form-control datepicker" />
                                    </div>
                                    <div class="col-md-12 align-content-end">
                                        <button type="button" id="addInventoryRow" class="btn btn-subtle-primary mb-1 mt-2 float-end" style="width:auto;">Add</button>
                                    </div>
                                </div>
                            </div>
                            <div id="salesInventoryData" class="d-none">
                                @if (Model.SalesInventoryDetails != null)
                                {
                                    var index = 0;
                                    foreach (var detail in Model.SalesInventoryDetails)
                                    {
                                        <div class="inventory-data" data-row-index="@index">
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].StockItemId, new { @class = "stockItemId" });
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].Quantity, new { @class = "quantity" });
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].Rate, new { @class = "rate" });
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].Discount, new { @class = "discount" });
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].Amount, new { @class = "amount" });
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].AccountingLedgerId, new { @class = "accountingLedgerId" });
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].GodownId, new { @class = "godownId" });
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].CostCentreId, new { @class = "costCentreId" })
                                            @Html.HiddenFor(m => m.SalesInventoryDetails[index].HasBatch, new { @class = "hasBatch" });

                                            @if (Model.SalesInventoryDetails[index].Batch != null)
                                            {
                                                @Html.HiddenFor(m => m.SalesInventoryDetails[index].Batch.Id, new { @class = "batchId" })
                                                ;
                                                @Html.HiddenFor(m => m.SalesInventoryDetails[index].Batch.BatchName, new { @class = "batchName" })
                                                ;
                                                @Html.HiddenFor(m => m.SalesInventoryDetails[index].Batch.StockItemId, new { @class = "batchStockItemId" })
                                                ;
                                                @Html.HiddenFor(m => m.SalesInventoryDetails[index].Batch.ExpiryDate, new { @class = "batchExpiry" })
                                                ;
                                                @Html.HiddenFor(m => m.SalesInventoryDetails[index].Batch.IsExpiryDate, new { @class = "isExpiryDate" })
                                                ;
                                            }
                                        </div>
                                        index++;
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 inventory-row @(Model.HasInventory ? "has-inventory" : "has-no-inventory")">
            <div class="table-responsive px-5 mb-5">
                <table class="salesInventoryTable table table-striped table-sm fs-9 mb-0">
                    <thead>
                        <tr>
                            <th>Inventory Name</th>
                            <th>Cost Centre</th>
                            <th>Quantity</th>
                            <th>Rate</th>
                            <th>Discount</th>
                            <th>Vat</th>
                            <th>Value</th>
                            <th style="float:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="salesInventoryTableBody" class="list">
                        @if (Model.SalesInventoryDetails != null)
                        {
                            var index = 0;
                            foreach (var detail in Model.SalesInventoryDetails)
                            {
                                var stockItem = stockItemList.FirstOrDefault(x => x.StockItemId == detail.StockItemId);
                                var costCentreName = "";
                                if (ViewBag.CostCentreList != null)
                                {
                                    var cc = ((List<SelectListItem>)ViewBag.CostCentreList).FirstOrDefault(x => x.Value == detail.CostCentreId.ToString());
                                    costCentreName = cc != null ? cc.Text : "";
                                }
                                <tr data-row-index="@index">
                                    <td>@stockItem?.StockItemName</td>
                                    <td class="costCentre">@costCentreName</td>
                                    <td>@detail.Quantity</td>
                                    <td>@detail.Rate</td>
                                    <td>@detail.Discount</td>
                                    <td class="taxRate">@stockItem?.TaxRate</td>
                                    <td class="amt">@detail.Amount</td>
                                    <td>
                                        <button type="button" class="btn btn-outline-danger remove-inventory-row float-end" data-row-index="@index" data-bs-toggle="tooltip" data-bs-placement="top" title="remove"><span class="align-bottom" data-feather="trash-2"></span></button>
                                        <button type="button" class="btn btn-outline-primary edit-inventory-row float-end me-2" data-row-index="@index" data-bs-toggle="tooltip" data-bs-placement="top" title="edit"><span class="align-bottom" data-feather="edit-3"></span></button>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row salesAdditionalLedger border-top border-translucent mt-3">
            <div class="col-md-4">
                <div class="mt-2">
                    <label class="form-label">Narration</label>
                    @Html.TextAreaFor(m => m.Narration, new { @class = "form-control", type = "text", placeholder = "Please enter narration", rows = "5" })
                </div>
            </div>
@*             <div class="col-md-1"></div>
 *@           
               <div class="col-md-8">
                <div class="mailing-section-header mt-3 mb-2 row" style="justify-content: space-between;">
                    <h5 class="mt-2" style="width:auto;">Sales Additional Ledger</h5>
                    <button type="button" id="addAdditionalLedger" class="btn btn-subtle-primary me-1 mb-1 mt-2" style="width:auto;">+ Row</button>
                </div>
                <div id="salesAdditionalLedgerContainer">
                    <div class="additional-ledgers-container">
                        @if (hasAdditionalLedger)
                        {
                            for (int i = 1; i < Model.SalesAdditionalLedgers.Count(); i++)
                            {

                                <div class="row ledger-row mb-3 p-2 border rounded bg-light ms-2" data-index="@i">
                                    @Html.HiddenFor(m => m.SalesAdditionalLedgers[i].Id)
                                    @Html.HiddenFor(m => m.SalesAdditionalLedgers[i].SalesId)
                                    @Html.HiddenFor(m => m.SalesAdditionalLedgers[i].LedgerPer, new { @class = "salesAdditionalPer" })

                                    <div class="col-md-3">
                                        <label class="form-label">Ledger</label>
