        $(document).ready(function () {
            function loadExchangeRate() {
            var currencyId = $('#currencyDropdown').val();
            var voucherDate = $('#voucherDate').val();             
                if (currencyId != "") {
                       $.ajax({
                    url: '/Voucher/get-exchangeRate',
                    type: 'GET',
                    data: {
            currencyId: currencyId,
            voucherDate: voucherDate
        },

                        success: function (response) {
                            if (response.success) {
                                $('#ExchangeRate').val(response.rate);

                            } else {

                                $('#ExchangeRate').val(1);
                                alert(response.message);
                            }
                        },
                        error: function (xhr) {
                            console.log(xhr);
                            alert('Error while fetching exchange rate');
                        }
                    });
                } else {

                    $('#ExchangeRate').val(1);
                }
            }
            loadExchangeRate();
            $('#currencyDropdown').change(function () {
                loadExchangeRate();
            });
            $('#voucherDate').change(function () {
                loadExchangeRate();
            });

        });

