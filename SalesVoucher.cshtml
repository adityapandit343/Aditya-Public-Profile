        function loadLedgerDetails(ledgerId) {
            if (!ledgerId || ledgerId == '') {
                return;
            }
            $('#LedgerIdInput').val(ledgerId);
            $.ajax({
                url: '/master/get-ledger-master-details',
                type: 'GET',
                data: { ledgerId: ledgerId },

                success: function (result) {
                    var data = result.data;
                    $('#BuyerName').val(data.buyerName || '');
                    $('#BuyerAddress1').val(data.buyerAddress1 || '');
                    $('#BuyerAddress2').val(data.buyerAddress2 || '');
                    $('#BuyerEmirate').val(data.buyerEmirate || '');
                    $('#BuyerCountry').val(data.buyerCountry || '');
                    $('#BuyerPobox').val(data.buyerPobox || '');
                    $('#BuyerTrn').val(data.buyerTrn || '');
                    $('#Consigneename').val(data.consigneeName || '');
                    $('#ConsigneeAddress1').val(data.consigneeAddress1 || '');
                    $('#ConsigneeAddress2').val(data.consigneeAddress2 || '');
                    $('#ConsigneeEmirate').val(data.consigneeEmirate || '');
                    $('#ConsigneeCountry').val(data.consigneeCountry || '');
                    $('#ConsigneePobox').val(data.consigneePobox || '');

                    var modalElement = document.getElementById('ledgerDetailsModal');
                    var existingModal = bootstrap.Modal.getInstance(modalElement);

                    if (existingModal) {
                        existingModal.dispose();
                    }
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                },

                error: function (xhr) {

                    console.log(xhr);

                    alert('Error loading ledger details');
                }
            });
        }

