        // Auto calculation vat amount logic
        function calculateVatForRows() {
            let vatAmount = 0;
            $("#salesInventoryTableBody").find("tr").each(function () {
                let amount = parseFloat($(this).find(".amt").text()) || 0;
                let taxRate = parseFloat($(this).find(".taxRate").text()) || 0;

                vatAmount += (amount * taxRate) / 100;

            });

            // Step 2: Loop through each additional ledger row
            $("#salesAdditionalLedgerContainer .additional-ledgers-container .ledger-row").each(function () {
                let ledgerTaxRate = parseFloat($(this).find("input[name*='LedgerTaxRate']").val()) || 0;
                let ledgerBaseAmount = parseFloat($(this).find(".salesAdditionalAmount").val()) || 0;

                // VAT for this ledger row
                vatAmount += (ledgerBaseAmount * ledgerTaxRate) / 100;
            });

            $(".vatTaxAmount").val(vatAmount.toFixed(2));
            calculateInvoiceAmount();
        }

        // base total amount field
        function getBaseAmount() {
            let amount = 0;

            $('.inventory-data').each(function(){
                let amt = parseFloat($(this).find('.amount').val());

                if (isNaN(amt)) amt = 0;

                amount += amt;
            });

            return amount;
        }

        // Auto calculation invoice amount logic
        function calculateInvoiceAmount() {
            let amount = getBaseAmount();

            $('#salesAdditionalLedgerContainer').find('.ledger-row').each(function(){
                let amt = parseFloat($(this).find('.taxRateAmount').val());

                if (isNaN(amt)) amt = 0;

                amount += amt;
            });

            $('#InvoiceValue').val(amount.toFixed(2));
        }

        // Auto calculation logic
        function calculateAmount($row) {
            let qty = parseFloat($row.find('#salesInputQuantity').val()) || 0;
            let rate = parseFloat($row.find('#salesInputRate').val()) || 0;
            let discount = parseFloat($row.find('#salesInputDiscount').val()) || 0;

            let amt = qty * rate;
            let amount = amt - ( amt * discount/100);
            if (amount < 0) amount = 0;

            $row.find('#salesInputAmount').val(amount.toFixed(2));

        }

        // Allow only numbers + one decimal point (blocks invalid keys as they're typed)
        $(document).on('keydown', '.decimal-only', function (e) {
            if (
                e.key === 'Backspace' ||
                e.key === 'Delete' ||
                e.key === 'ArrowLeft' ||
                e.key === 'ArrowRight' ||
                e.key === 'Tab'
            ) {
                return;
            }
            if (e.key === '.' && this.value.indexOf('.') !== -1) {
                e.preventDefault();
                return;
            }
            if (!/^[0-9.]$/.test(e.key)) {
                e.preventDefault();
            }
        });

        // Sanitize on input (covers paste, autofill, etc.)
        $(document).on('input', '.decimal-only', function () {
            let val = $(this).val();
            val = val.replace(/[^0-9.]/g, '');
            let parts = val.split('.');
            if (parts.length > 2) {
                val = parts[0] + '.' + parts.slice(1).join('');
            }
            $(this).val(val);
        });

        $(document).on('keydown', '.integer-only', function (e) {
            if (
                e.key === 'Backspace' ||
                e.key === 'Delete' ||
                e.key === 'ArrowLeft' ||
                e.key === 'ArrowRight' ||
                e.key === 'Tab'
            ) {
                return;
            }
            if (
                e.key === '-' ||
                e.key === '+' ||
                e.key === 'e' ||
                e.key === 'E' ||
                e.key === '.'
            ) {
                e.preventDefault();
            }
            if (!/^\d$/.test(e.key)) {
                e.preventDefault();
            }
        });
        $(document).on('input', '.integer-only', function () {
            let val = $(this).val();
            if (val === '') return;
            val = parseInt(val, 10);
            if (isNaN(val) || val < 0) {
                val = 0;
            }
            let min = $(this).attr('min');
            let max = $(this).attr('max');
            if (min !== undefined && val < min) val = min;
            if (max !== undefined && val > max) val = max;
            $(this).val(val);
        });

